{
  "name": "enhanced-image-previewer",
  "version": "1.2.0",
  "description": "Chrome MV3 extension for previewing page images with zoom and drag interactions.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
