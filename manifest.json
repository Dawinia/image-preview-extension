{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "dawinialo@gmail.com",
  "homepage_url": "https://github.com/dawinialo/image-preview-extension",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/core.js", "src/content/previewer.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "__MSG_executeActionCommand__"
    },
    "toggle_last_preview": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_toggleLastPreviewCommand__"
    }
  }
}
